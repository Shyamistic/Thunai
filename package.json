{
  "name": "thunai-1913",
  "private": true,
  "version": "1.0.0",
  "description": "Thunai 1913: Tanglish flood-helpline call-taker and triage board for Chennai, built on Gnani Prisma v3.0 and Timbre v3.0.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/extract.test.ts tests/triage.test.ts tests/dialog.test.ts",
    "voicenotes": "tsx scripts/make-voicenotes.ts",
    "backlog": "tsx scripts/run-backlog.ts",
    "eval": "tsx scripts/eval-noise.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
