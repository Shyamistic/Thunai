# Gnani AI key from https://app.gnani.ai/voice (server-side only, never sent to the browser)
GNANI_API_KEY=
PORT=8787

# CARTO basemaps key for the dark map (browser-side tile key). Without it the map falls back to Esri dark gray.
VITE_CARTO_KEY=

# Set to 1 when hosting publicly: turns on per-visitor rate limits and disables live Batch runs.
PUBLIC_DEMO=0

# Optional: any OpenAI-compatible chat endpoint (Groq, Gemini, or Evon served with vLLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
